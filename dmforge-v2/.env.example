# Copy to .env (never commit .env) and fill in.
# A long random token you will type once per device:   openssl rand -base64 24
DMFORGE_TOKEN=
# The name shown in the app
DMFORGE_NAME=My Campaigns
# Your machine's Tailscale name, so no other Host name is accepted (see deploy/DEPLOY-V3.md). Leave empty to accept any.
DMFORGE_HOSTS=
# Your user and group id on the server (run `id`); Linux Mint's first user is normally 1000
DMFORGE_UID=1000
DMFORGE_GID=1000
TZ=Australia/Sydney
DMFORGE_BACKUP_HOUR=3
DMFORGE_BACKUP_KEEP=14
# Where DMAtlas publishes dungeons, for "Import a dungeon from DMAtlas". Leave empty to switch the importer off.
# Check that this server can reach it:  docker compose exec dmforge python -I dmforge_atlas.py
DMFORGE_DMATLAS_URL=https://water.tail029b78.ts.net:8767
